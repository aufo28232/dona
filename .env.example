# Postgres — funciona com Vercel Postgres (Neon), Supabase, Railway, etc.
# Supabase: use a "Connection string" do Transaction Pooler (porta 6543).
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Sal usado no hash SHA-256 dos IPs. GERE UM VALOR ALEATÓRIO E MANTENHA SECRETO.
# Trocar esse valor invalida todos os cooldowns já registrados.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT="troque-isso-por-uma-string-aleatoria-longa"

# App registrado em https://dev.twitch.tv/console/apps — categoria "Website
# Integration". Adicione como OAuth Redirect URL:
#   http://localhost:3000/api/auth/twitch/callback   (dev)
#   https://SEU-SITE/api/auth/twitch/callback         (produção)
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# Só precisa em produção se o domínio final for diferente do host que recebe
# o request (ex: atrás de outro proxy). Em geral pode deixar vazia — é
# derivada automaticamente do host que bateu na rota.
TWITCH_REDIRECT_URI=""

# Assina o cookie de sessão do login com a Twitch. GERE UM VALOR ALEATÓRIO E
# MANTENHA SECRETO. Trocar esse valor desloga todo mundo.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="troque-isso-por-uma-string-aleatoria-longa"

# Token do dono do projeto para baixar os dados brutos em /api/admin/export.
# Se ficar vazio, a rota responde 404 e ninguém acessa os dados.
ADMIN_TOKEN=""

# URL pública do site (usada no botão de compartilhar).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
